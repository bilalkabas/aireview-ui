# Webapp Configuration
WEBAPP_SHOW_HARMONIZED_BY_DEFAULT=true
WEBAPP_DEFAULT_HARMONIZATION_MODEL=gpt-5-chat-latest

# Admin Mode (enables reviewer type labels, model dropdown, and split view)
WEBAPP_ADMIN_MODE=false

# Review Shuffling
WEBAPP_SHUFFLE_REVIEWS=true
WEBAPP_SHUFFLE_SEED=42
WEBAPP_PROJECT_ROOT=.
WEBAPP_WEB_ROOT=webapp
WEBAPP_VENV_DIR=.venv
WEBAPP_REQUIREMENTS_FILE=webapp/requirements.txt
WEBAPP_REVIEWS_JSON=reviews/evaluation-data-all-venues.json
WEBAPP_PDFS_ROOT=pdfs
WEBAPP_ENV_FILE=.env

# PDF Download - GitHub Releases
# PDFs will be downloaded from this GitHub releases URL
WEBAPP_GITHUB_RELEASES_PDF_URL=https://github.com/bilalkabas/aireview-ui/releases/download/pdfs/pdfs.zip

# Harmonization
OPENAI_API_KEY=
HARMONIZATION_INPUT_FILE=reviews/evaluation-data-all-venues.json
HARMONIZATION_OUTPUT_FILE=
HARMONIZATION_MODEL=gpt-5-chat-latest
HARMONIZATION_MAX_CONCURRENT=10
# ---------------------------------------------------------------- Ensemble phase (./run_ensemble)
WEBAPP_ENSEMBLE_REVIEWS_JSON=reviews/evaluation-data-ensemble.json
WEBAPP_ENSEMBLE_PORT=8091
# PDFs are placed by hand; nothing is downloaded. Paper URLs are relative to the PDF root,
# so <root>/<subdir>/TMI-2025-XXXX.pdf must exist. Root defaults to the project directory.
WEBAPP_ENSEMBLE_PDFS_ROOT=.
WEBAPP_ENSEMBLE_PDFS_SUBDIR=AI4TMI_pdfs
# Set to true to show reviewer labels (reveals AI/human — evaluators must keep this false).
WEBAPP_ENSEMBLE_ADMIN_MODE=false
